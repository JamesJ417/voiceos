[Unit]
Description=VoiceOS task and memory authority
After=network-online.target
Wants=network-online.target
Before=voiceos-gateway.service

[Service]
Type=simple
WorkingDirectory=@@REPO_ROOT@@
Environment=VOICEOS_RUST_LISTEN=127.0.0.1:8790
Environment=VOICEOS_RUST_DATA_DIR=%h/.local/state/voiceos/core
Environment=VOICEOS_LEGACY_AUDIT_PATH=%h/.local/state/voiceos/audit.sqlite3
Environment=VOICEOS_IMPORT_AUDIT=%h/.local/state/voiceos/audit.sqlite3
Environment=VOICEOS_PRIMARY_OWNER_ID=omarchy-voice-owner
ExecStart=@@RUST_GATEWAY@@
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=%h/.local/state/voiceos

[Install]
WantedBy=default.target
