# VIC-DOM: local-first VoiceOS gateway for Brick and Copper Restaurant.
VOICEOS_DEPLOYMENT_ID=vic-dom
VOICEOS_ORGANIZATION_NAME=Brick and Copper Restaurant
VOICEOS_OPERATIONS_SYSTEM_NAME=DOM
VOICEOS_PROVIDER=hermes
# Local Touch starts on loopback. Do not publish port 8787 through Tailscale
# until device authentication and restaurant roles have been reviewed.
VOICEOS_REQUIRE_DEVICE_AUTH=1
VOICEOS_DATA_DIR=%h/.local/state/voiceos
VOICEOS_TIME_ZONE=America/New_York
VOICEOS_DEPLOYMENT_CONTEXT_PATH=%h/.config/voiceos/deployment-context.md
VOICEOS_CODEX_ENABLED=1
VOICEOS_CODEX_SOCKET=%t/voiceos-codex/codex.sock
VOICEOS_HERMES_URL=http://127.0.0.1:8642
VOICEOS_HERMES_API_KEY_FILE=%h/.config/voiceos/hermes-api.key
VOICEOS_HERMES_MODEL=hermes
VOICEOS_FAST_CHAT_MODEL=gpt-5.6-luna
VOICEOS_HERMES_ASYNC_RUNS=1
VOICEOS_WHISPER_MODEL=%h/.local/share/voiceos/models/ggml-base.en.bin
# Direct computer control starts disabled. Enable only after the destination's
# DOM adapters and typed approval path have been reviewed.
VOICEOS_COMPUTER_ACCESS=0

# Signed external transcript intake remains disabled until explicitly configured.
VOICEOS_FIELDY_WEBHOOK_SECRET=
VOICEOS_FIELDY_AUTO_EXTRACT=1

# Local task, memory, ontology, and document authority.
VOICEOS_MEMORY_URL=http://127.0.0.1:8790
# Must match the private value in core.env. Blank keeps Rust internal routes closed.
VOICEOS_RUST_SERVICE_TOKEN=

# Optional local model lanes. Enable only after their services are healthy.
VOICEOS_OLLAMA_URL=http://127.0.0.1:11434
VOICEOS_OLLAMA_MODEL=
VOICEOS_OLLAMA_DEEP_MODEL=
