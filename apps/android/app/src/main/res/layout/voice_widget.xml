<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="OV  •  READY"
            android:textColor="@color/voice_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_refresh"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:backgroundTint="@color/voice_surface_raised"
            android:contentDescription="Refresh VIC tasks"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="↻"
            android:textColor="@color/voice_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_gateway"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Private gateway"
        android:textColor="@color/voice_text_muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_task_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.08"
        android:text="NEXT TASKS"
        android:textColor="@color/voice_primary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_task_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_task_recommended_background"
        android:orientation="vertical"
        android:paddingHorizontal="9dp"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/widget_task_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/voice_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task_meta_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="2dp"
            android:textColor="@color/voice_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_task_background"
        android:orientation="vertical"
        android:paddingHorizontal="9dp"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/widget_task_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/voice_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task_meta_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/voice_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_task_background"
        android:orientation="vertical"
        android:paddingHorizontal="9dp"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/widget_task_title_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/voice_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task_meta_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/voice_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="10dp"
        android:text="Nothing urgent. Tap + ADD or talk with VIC."
        android:textColor="@color/voice_text_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_talk"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:backgroundTint="@color/voice_primary"
            android:letterSpacing="0.12"
            android:text="TALK"
            android:textColor="#06100E"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_start_task"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1.35"
            android:backgroundTint="@color/voice_primary"
            android:text="START VIC PICK"
            android:textColor="#06100E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_add_task"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:layout_weight="0.8"
            android:backgroundTint="@color/voice_primary_dark"
            android:text="+ ADD"
            android:textColor="@color/voice_text"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
