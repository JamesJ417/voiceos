[Unit]
Description=VoiceOS credential-driven signal connectors
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voiceos
Group=voiceos
WorkingDirectory=@@REPO_ROOT@@
Environment=PYTHONPATH=@@REPO_ROOT@@
EnvironmentFile=-/etc/voiceos/voiceos-connectors.env
ExecStart=/usr/bin/python3 -m services.gateway.connector_signals --host 127.0.0.1 --port 8795
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/voiceos/connectors

[Install]
WantedBy=multi-user.target
