#!/usr/bin/env bash
set -euo pipefail

browser="$(command -v google-chrome-stable || true)"
if [[ -z "$browser" ]]; then
  echo "Google Chrome is required for Touch speech recognition." >&2
  exit 1
fi

systemctl --user start voiceos-hermes.service voiceos-codex.service voiceos-gateway.service voiceos-ui.service
for _ in {1..40}; do
  if curl --fail --silent http://127.0.0.1:3000 >/dev/null; then
    exec "$browser" \
      --app=http://127.0.0.1:3000 \
      --autoplay-policy=no-user-gesture-required \
      --user-data-dir="${XDG_STATE_HOME:-$HOME/.local/state}/voiceos/chrome-browser"
  fi
  sleep 0.25
done

echo "Touch did not become ready." >&2
exit 1
