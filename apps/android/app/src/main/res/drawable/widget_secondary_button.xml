<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#243638" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#35E0C1" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#243033" android:endColor="#121719" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#4F7370" />
        </shape>
    </item>
</selector>
