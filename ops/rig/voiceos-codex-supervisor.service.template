[Unit]
Description=VoiceOS governed Codex subagent supervisor
After=network-online.target voiceos-rust.service
Requires=voiceos-rust.service

[Service]
Type=simple
User=llm
Group=voiceos
WorkingDirectory=@@REPO_ROOT@@
EnvironmentFile=/etc/voiceos/rust.env
Environment=HOME=/home/llm
Environment=PATH=/home/llm/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=VOICEOS_CODEX_REPOSITORY=@@REPO_ROOT@@
ExecStart=/usr/bin/python3 -m services.codex_supervisor.supervisor
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@@REPO_ROOT@@ /home/llm/.codex /var/lib/voiceos-codex

[Install]
WantedBy=multi-user.target
