{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiceos.local/contracts/speech-session.schema.json",
  "title": "Omarchy Voice full-duplex speech session",
  "type": "object",
  "required": ["session_id", "conversation_id", "input_sample_rate_hz", "output_sample_rate_hz", "codec", "transport_protocol", "protocol_version", "backend", "stream_path", "connection_deadline_unix"],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "conversation_id": { "type": "string", "minLength": 1 },
    "input_sample_rate_hz": { "const": 24000 },
    "output_sample_rate_hz": { "const": 24000 },
    "codec": { "const": "ogg_opus_mono" },
    "transport_protocol": {
      "const": "moshi-websocket-v0",
      "description": "Binary WebSocket messages use a one-byte Moshi type prefix: handshake=0, audio=1, text=2, control=3, metadata=4, error=5, ping=6. Audio payloads contain Ogg Opus pages at 24 kHz mono."
    },
    "protocol_version": { "const": 0 },
    "backend": { "type": "string", "enum": ["moshi-candle-q8", "mock"] },
    "stream_path": { "type": "string", "pattern": "^/v1/stream/" },
    "connection_deadline_unix": { "type": "integer", "minimum": 1 },
    "expires_at_unix": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
