<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="VIC"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.11"
                android:text="VIC  //  READY"
                android:textColor="@color/voice_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_gateway"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="PRIVATE VOICEOS LINK"
                android:textColor="@color/voice_text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <Button
            android:id="@+id/widget_refresh"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_secondary_button"
            android:contentDescription="Refresh VoiceOS tasks"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="&#8635;"
            android:textColor="@color/voice_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_task_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:letterSpacing="0.08"
        android:text="MISSION QUEUE"
        android:textColor="@color/voice_primary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_task_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_task_background"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp">
        <TextView android:id="@+id/widget_task_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/voice_text" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_task_meta_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/voice_text_muted" android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_task_background"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp">
        <TextView android:id="@+id/widget_task_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/voice_text" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_task_meta_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/voice_text_muted" android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_task_background"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp">
        <TextView android:id="@+id/widget_task_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/voice_text" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_task_meta_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/voice_text_muted" android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="10dp"
        android:text="Queue clear. Add a task or talk to VIC."
        android:textColor="@color/voice_text_muted"
        android:textSize="11sp" />

    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/widget_talk"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.45"
            android:background="@drawable/widget_primary_button"
            android:letterSpacing="0.09"
            android:text="TALK TO VIC"
            android:textColor="#06100E"
            android:textStyle="bold" />
        <Button
            android:id="@+id/widget_add_task"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_button"
            android:text="+ TASK"
            android:textColor="@color/voice_text"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
