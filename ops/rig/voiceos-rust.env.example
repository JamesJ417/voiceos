VOICEOS_RUST_LISTEN=127.0.0.1:8790
VOICEOS_RUST_DATA_DIR=/var/lib/voiceos-rust
VOICEOS_LEGACY_AUDIT_PATH=/var/lib/voiceos/audit.sqlite3
VOICEOS_REQUIRE_DEVICE_AUTH=1
VOICEOS_OLLAMA_URL=http://127.0.0.1:11434
VOICEOS_GEMMA_MODEL=gemma4-fast:12b
VOICEOS_SLEEP_MEMORY_ENABLED=0
VOICEOS_SLEEP_MODEL_MODE=routed
VOICEOS_GPT_OSS_MODEL=gpt-oss:20b
VOICEOS_CODEX_ENABLED=1
VOICEOS_CODEX_SOCKET=/run/voiceos-codex/codex.sock
# Keep disabled while deterministic shadow decisions are evaluated. When enabled,
# only explicit /v1/ontology/interpret calls use the structured local-model fallback.
VOICEOS_ONTOLOGY_MODEL_FALLBACK=0
VOICEOS_ONTOLOGY_MODEL=gemma
