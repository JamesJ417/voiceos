VOICEOS_PROVIDER=ollama
VOICEOS_OLLAMA_URL=http://127.0.0.1:11434
VOICEOS_OLLAMA_MODEL=replace-with-installed-model
VOICEOS_OLLAMA_DEEP_MODEL=
VOICEOS_CODEX_ENABLED=0
VOICEOS_CODEX_SOCKET=/run/voiceos-codex/codex.sock
VOICEOS_REQUIRE_DEVICE_AUTH=1
VOICEOS_DATA_DIR=/var/lib/voiceos
VOICEOS_MEMORY_URL=http://127.0.0.1:8790
VOICEOS_REVIEW_SCHEDULER_ENABLED=1
VOICEOS_SLEEP_SCHEDULER_ENABLED=0
VOICEOS_SLEEP_AUTOMATIC_COMMITS=0
# Generate a long random value and set the same value in rust.env.
VOICEOS_INTERNAL_TOKEN=replace-with-random-internal-token
# Optional owner-authorized adapter returning {"signals": [...]}.
VOICEOS_EMAIL_SIGNALS_URL=http://127.0.0.1:8795/v1/email-signals
VOICEOS_CALENDAR_SIGNALS_URL=http://127.0.0.1:8795/v1/calendar-signals
VOICEOS_COMMUNICATION_SIGNALS_URL=http://127.0.0.1:8795/v1/communication-signals
VOICEOS_REVIEW_MODEL=ollama
# Set VOICEOS_PROVIDER=hermes after the isolated Hermes service is healthy.
VOICEOS_HERMES_URL=http://127.0.0.1:8642
VOICEOS_HERMES_MODEL=hermes
VOICEOS_HERMES_API_KEY_FILE=/etc/voiceos/hermes-api.key
VOICEOS_HERMES_ASYNC_RUNS=1
VOICEOS_HERMES_SKILL_WORKER_URL=http://127.0.0.1:8794
VOICEOS_HERMES_SKILL_WORKER_TOKEN_FILE=/etc/voiceos/hermes-skill-worker.key
