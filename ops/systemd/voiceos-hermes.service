[Unit]
Description=VoiceOS Hermes core agent runtime
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=voiceos-hermes
Group=voiceos-agents
Environment=HOME=/var/lib/voiceos/hermes
Environment=HERMES_HOME=/var/lib/voiceos/hermes
Environment=VOICEOS_HERMES_API_KEY_FILE=/etc/voiceos/hermes-api.key
WorkingDirectory=/var/lib/voiceos/hermes/workspace
ExecStart=/opt/voiceos/bin/run-hermes
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/voiceos/hermes

[Install]
WantedBy=multi-user.target
