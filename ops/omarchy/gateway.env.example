# Safe local-first defaults for an Omarchy workstation.
VOICEOS_PROVIDER=hermes
VOICEOS_REQUIRE_DEVICE_AUTH=0
VOICEOS_DATA_DIR=%h/.local/state/voiceos
VOICEOS_TIME_ZONE=America/New_York
VOICEOS_CODEX_ENABLED=1
VOICEOS_CODEX_SOCKET=%t/voiceos-codex/codex.sock
VOICEOS_HERMES_URL=http://127.0.0.1:8642
VOICEOS_HERMES_API_KEY_FILE=%h/.config/voiceos/hermes-api.key
VOICEOS_HERMES_MODEL=hermes
VOICEOS_FAST_CHAT_MODEL=gpt-5.6-luna
VOICEOS_HERMES_ASYNC_RUNS=1
VOICEOS_WHISPER_MODEL=%h/.local/share/voiceos/models/ggml-base.en.bin
VOICEOS_COMPUTER_ACCESS=1

# Optional authenticated Fieldy transcript intake. Generate a private random
# value and use it as the webhook URL's `token` query parameter. Signed clients
# may use the same value as their HMAC-SHA256 key.
VOICEOS_FIELDY_WEBHOOK_SECRET=

# Local task, memory, ontology, and document authority installed by setup.sh.
VOICEOS_MEMORY_URL=http://127.0.0.1:8790

# Enable these only after their local services are installed and healthy.
VOICEOS_OLLAMA_URL=http://127.0.0.1:11434
VOICEOS_OLLAMA_MODEL=
VOICEOS_OLLAMA_DEEP_MODEL=
