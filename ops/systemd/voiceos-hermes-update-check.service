[Unit]
Description=Discover Hermes updates without changing production
After=network-online.target voiceos-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
User=voiceos
Group=voiceos
WorkingDirectory=/opt/voiceos
ExecStart=/usr/bin/python3 /opt/voiceos/ops/agents/check_hermes_upstream.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/voiceos/update-candidates
