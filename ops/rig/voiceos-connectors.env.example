# Put either access tokens or refreshable OAuth JSON objects containing
# client_id, client_secret, and refresh_token in root-owned mode-0640 files.
# Never place those files in this repository.
VOICEOS_GMAIL_TOKEN_FILE=/etc/voiceos/secrets/gmail-access-token
VOICEOS_CALENDAR_TOKEN_FILE=/etc/voiceos/secrets/calendar-access-token
VOICEOS_CONNECTOR_INGEST_TOKEN_FILE=/etc/voiceos/secrets/connector-ingest-token
VOICEOS_COMMUNICATION_SIGNAL_FILE=/var/lib/voiceos/connectors/communication.json
